# Public Firebase web configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=artistic-soham
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Server-only Firebase Admin credentials.
# On Firebase/Google-hosted runtimes, Application Default Credentials may be used.
FIREBASE_ADMIN_PROJECT_ID=artistic-soham
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Server-only Cloudinary credentials.
# Do NOT expose these as NEXT_PUBLIC_* variables.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Custom password reset / transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=Artistic Soham <no-reply@your-domain.com>
APP_URL=https://your-production-domain.example
APP_PUBLIC_LOGO_URL=https://res.cloudinary.com/YOUR_CLOUD_NAME/image/upload/f_auto,q_auto/artistic-soham/site-assets/brand/logo-main

NEXT_PUBLIC_BRAND_LOGO_URL=https://res.cloudinary.com/YOUR_CLOUD_NAME/image/upload/f_auto,q_auto/artistic-soham/site-assets/brand/logo-main

# AI-assisted promotion studio (server-only)
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/responses
AI_MODEL=gpt-5-mini

# Public Cloudinary delivery base for website-owned static images.
NEXT_PUBLIC_CLOUDINARY_ASSET_BASE_URL=https://res.cloudinary.com/YOUR_CLOUD_NAME/image/upload/f_auto,q_auto/artistic-soham/site-assets

# India delivery pricing. Production rules are stored in Firestore collection `deliveryRules` from Admin > Courier Pricing.
# This JSON is only a local/server fallback when Firestore has no deliveryRules documents.
DELIVERY_RULES_JSON=[]
# STANDARD or EXPRESS can be selected by the order flow.
DELIVERY_DEFAULT_SERVICE_LEVEL=STANDARD
